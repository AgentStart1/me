{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "android-device-lock",
  "version": "0.5.3-20261107120055",
  "description": "跨项目、跨测试框架的 Android adb 设备锁，独立于目标项目运行。",
  "author": {
    "name": "Local Android Practices"
  },
  "license": "MIT",
  "keywords": [
    "android",
    "adb",
    "testing",
    "e2e",
    "lock"
  ],
  "extensions": {
    "com.openai.codex": {
      "skills": "./skills/",
      "interface": {
        "displayName": "Android 设备锁",
        "shortDescription": "让共享设备上的 Android 测试串行执行。",
        "longDescription": "在目标项目之外管理共享 Android 设备访问。调用已安装的 adb 锁工具，保持现有测试命令不变并释放租约，无需复制脚本或添加项目、CI 集成。",
        "developerName": "Local Android Practices",
        "category": "Developer Tools",
        "capabilities": [
          "Code Generation",
          "Testing",
          "Android"
        ],
        "defaultPrompt": [
          "在插件管理的设备锁下运行此现有 Android 测试命令，不修改项目。",
          "将这些 Android 设备测试串行执行，让一台设备每次只运行一套测试。",
          "测试前通过 adb 等待已有设备锁释放。",
          "显示设备锁归属和租约到期时间。"
        ],
        "brandColor": "#0F766E"
      },
      "mcpServers": "./.mcp.json"
    },
    "com.anthropic.claude": {
      "skillFrontmatter": {
        "android-device-lock": {
          "context": "fork",
          "agent": "android-e2e-operator"
        }
      },
      "mcpServers": "./.mcp.json"
    }
  }
}
