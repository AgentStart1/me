@@ -383,11 +383,23 @@ pub(super) fn host_page() -> Option<u64> {
 }
 
 /// The host's page size, where the runtime knows how to ask for it: not on this system.
-#[cfg(not(unix))]
+#[cfg(not(any(unix, target_os = "windows")))]
 pub(super) fn host_page() -> Option<u64> {
     None
 }
 
+/// The native page size Windows permits for external host-memory imports.
+#[cfg(target_os = "windows")]
+pub(super) fn host_page() -> Option<u64> {
+    let mut info = std::mem::MaybeUninit::uninit();
+    // SAFETY: GetSystemInfo fills the complete SYSTEM_INFO output structure.
+    unsafe {
+        windows_sys::Win32::System::SystemInformation::GetSystemInfo(info.as_mut_ptr());
+        let page = u64::from(info.assume_init().dwPageSize);
+        (page > 0).then_some(page)
+    }
+}
+
