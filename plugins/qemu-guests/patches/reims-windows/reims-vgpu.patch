@@ -0,0 +1,120 @@
+//! Writable aliases for read-only imported pages. GPU writes through such an alias are refused.
+use super::vm::{self, WindowsVm};
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::platform::os::vm::{HostAddr, HostVm, KernReturn, VmProt};
+use reims_vgpu_core::sync::Mutex;
+use std::collections::BTreeMap;
+use std::ptr::NonNull;
+
+pub(crate) const TWINS_READ_ONLY: bool = true;
+static TWINS: Mutex<BTreeMap<u64, (u64, u64)>> = Mutex::new(BTreeMap::new());
+pub(crate) fn allocate_zeros(length: u64) -> Result<HostAddr, KernReturn> {
+    vm::allocate_aliasable(length)
+}
+#[derive(Debug)]
+struct Twin {
+    first: u64,
+    length: u64,
+}
+impl Drop for Twin {
+    fn drop(&mut self) {
+        TWINS.lock().remove(&self.first);
+        let _ = WindowsVm::new().deallocate(HostAddr::from_addr(self.first as usize), self.length);
+    }
+}
+#[derive(Debug)]
+pub(crate) struct ImportView {
+    at: NonNull<u8>,
+    twin: Option<Twin>,
+}
+struct SendPtr(NonNull<u8>);
+// SAFETY: only passed to the original deallocator after the import has completed.
+unsafe impl Send for SendPtr {}
+impl SendPtr {
+    fn get(&self) -> NonNull<u8> {
+        self.0
+    }
+}
+impl ImportView {
+    pub(crate) fn at(&self) -> NonNull<u8> {
+        self.at
+    }
+    pub(crate) fn writes_kept(&self) -> bool {
+        self.twin.is_some()
+    }
+    pub(crate) fn release(
+        self,
+        original: NonNull<u8>,
+        inner: Option<rt::Deallocator>,
+    ) -> (Option<rt::Deallocator>, Option<rt::KeepAlive>) {
+        let Some(twin) = self.twin else {
+            return (inner, None);
+        };
+        let original = SendPtr(original);
+        let inner = inner.map(|inner| -> rt::Deallocator {
+            Box::new(move |_, length| inner(original.get(), length))
+        });
+        (inner, Some(Box::new(twin)))
+    }
+}
+pub(crate) fn import_view(at: NonNull<u8>, length: u64) -> ImportView {
+    let plain = ImportView { at, twin: None };
+    let page = WindowsVm::new().page_size();
+    let start = at.as_ptr() as u64;
+    let first = start & !(page - 1);
+    let Some(end) = start
+        .checked_add(length.max(1))
+        .and_then(|v| v.checked_next_multiple_of(page))
+    else {
+        return plain;
+    };
+    let Some(pieces) = vm::pieces(first, end - first) else {
+        return plain;
+    };
+    if pieces
+        .iter()
+        .all(|p| p.backing.prot.raw() & VmProt::WRITE.raw() != 0)
+    {
+        return plain;
+    }
+    let Ok(base) = WindowsVm::new().allocate_anywhere(end - first) else {
+        return plain;
+    };
+    if vm::writable_alias(base, first, end - first).is_err() {
+        let _ = WindowsVm::new().deallocate(base, end - first);
+        return plain;
+    }
+    let twin = Twin {
+        first: base.addr() as u64,
+        length: end - first,
+    };
+    TWINS.lock().insert(twin.first, (twin.length, first));
+    ImportView {
+        at: NonNull::new(std::ptr::with_exposed_provenance_mut(
+            (twin.first + start - first) as usize,
+        ))
+        .unwrap_or(at),
+        twin: Some(twin),
+    }
+}
+pub(crate) unsafe fn host_memory(at: NonNull<u8>) -> rt::HostMemory {
+    // SAFETY: the caller retains writable mapped pages for the import's lifetime.
+    unsafe { rt::HostMemory::new(at) }
+}
+pub(crate) fn shown_at(at: NonNull<u8>) -> NonNull<u8> {
+    let address = at.as_ptr() as u64;
+    let twins = TWINS.lock();
+    let Some((&base, &(length, source))) = twins.range(..=address).next_back() else {
+        return at;
+    };
+    if address >= base + length {
+        return at;
+    }
+    NonNull::new(std::ptr::with_exposed_provenance_mut(
+        (source + address - base) as usize,
+    ))
+    .unwrap_or(at)
+}
+pub(crate) fn dma_buf_refusal() -> Option<String> {
+    None
+}
