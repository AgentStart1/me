+//! Native Windows clocks, threads, shared section memory and Vulkan presentation.
+mod import;
+mod services;
+pub(super) mod vm;
+
+use super::GuestRamFile;
+pub use super::surface_standin::{StandInSurface as OsSurface, StandInSurfaces as OsSurfaces};
+pub(crate) use super::surface_standin::{
+    plane_at, plane_shape, recorded_mut, surface_memory_hold, ycbcr_matrix,
+};
+pub(crate) use import::{
+    TWINS_READ_ONLY, allocate_zeros, dma_buf_refusal, host_memory, import_view, shown_at,
+};
+use metal2vulkan_runtime as rt;
+pub use services::{WindowsClock as OsClock, WindowsThreads as OsThreads};
+use std::ffi::CStr;
+pub(crate) use vm::allocate_aliasable;
+pub use vm::{GuestMemoryLease, WindowsVm as OsVm};
+
+/// Holds each guest section until its device has completed teardown.
+pub fn lease_guest_memory(ranges: impl IntoIterator<Item = GuestRamFile>) -> GuestMemoryLease {
+    vm::register_guest_memory(
+        ranges
+            .into_iter()
+            .map(|r| (r.host, r.length, r.section, r.offset)),
+    )
+}
+pub(crate) const WINDOW_SURFACE_EXTENSIONS: [&CStr; 1] = [ash::khr::win32_surface::NAME];
+pub(crate) const WINDOW_DEVICE_EXTENSIONS: [&CStr; 0] = [];
+pub(crate) fn open_loader() -> Result<ash::Entry, ash::LoadingError> {
+    // SAFETY: the Vulkan loader is retained with the returned entry.
+    unsafe { ash::Entry::load() }
+}
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Drawables {}
+impl Drawables {
+    pub(crate) fn load(_: &rt::Device) -> Option<Self> {
+        None
+    }
+    pub(crate) unsafe fn fetch(&self, _: ash::vk::Image) -> bool {
+        match *self {}
+    }
+}
+/// No process-wide limit changes are needed for section-backed memory.
+pub fn install_process_services() {}
+/// The same Metal feature level used by the native Linux Vulkan platform.
+pub const METAL_LEVEL: Option<rt::MetalLevel> = Some(rt::MetalLevel::MacOS26_7);
+/// Windows has no Metal device registry to consult.
+pub fn default_registry_id() -> Option<u64> {
+    None
+}
+/// The runtime supplies the device's core count.
+pub fn default_gpu_core_count() -> Option<u64> {
+    None
+}
+pub(super) fn physical_memory() -> u64 {
+    let mut status = windows_sys::Win32::System::SystemInformation::MEMORYSTATUSEX {
+        dwLength: size_of::<windows_sys::Win32::System::SystemInformation::MEMORYSTATUSEX>() as u32,
+        ..Default::default()
+    };
+    // SAFETY: the structure has the required size and is writable.
+    if unsafe { windows_sys::Win32::System::SystemInformation::GlobalMemoryStatusEx(&mut status) }
+        == 0
+    {
+        0
+    } else {
+        status.ullTotalPhys
+    }
+}
