+++ b/crates/reims-vgpu-vulkan/src/os/windows/services.rs
@@ -0,0 +1,112 @@
+//! Clocks include host sleep; detached threads retain the platform's timing contract.
+use reims_vgpu_core::platform::os::{
+    Clock, Deadline, MonoTime, Threads, TimedOut, TimerClock, WallTime,
+};
+use reims_vgpu_core::raise::death::{DeathId, DeathKind, fatal};
+use reims_vgpu_core::sync::{Condvar, MutexGuard};
+use std::sync::Arc;
+use std::time::Duration;
+
+/// Precise Win32 interrupt time and Unix-epoch wall time.
+#[derive(Debug, Default)]
+pub struct WindowsClock;
+impl WindowsClock {
+    /// The process's clock.
+    pub fn new() -> Self {
+        Self
+    }
+    fn remaining(&self, d: Deadline) -> Duration {
+        match d {
+            Deadline::Mono(t) => t.saturating_duration_since(self.now_mono()),
+            Deadline::Wall(t) => t.saturating_duration_since(self.now_wall()),
+        }
+    }
+}
+impl Clock for WindowsClock {
+    fn now_mono(&self) -> MonoTime {
+        let mut ticks = 0;
+        // SAFETY: the system fills this 100-nanosecond interrupt-time counter.
+        unsafe {
+            windows_sys::Win32::System::WindowsProgramming::QueryInterruptTimePrecise(&mut ticks);
+        }
+        MonoTime::from_nanos(ticks.saturating_mul(100))
+    }
+    fn now_wall(&self) -> WallTime {
+        let mut time = windows_sys::Win32::Foundation::FILETIME::default();
+        // SAFETY: the system fills a FILETIME, measured from 1601 in 100-nanosecond ticks.
+        unsafe {
+            windows_sys::Win32::System::SystemInformation::GetSystemTimePreciseAsFileTime(
+                &mut time,
+            );
+        }
+        let ticks = (u64::from(time.dwHighDateTime) << 32) | u64::from(time.dwLowDateTime);
+        WallTime::from_nanos(
+            ticks
+                .saturating_sub(116_444_736_000_000_000)
+                .saturating_mul(100),
+        )
+    }
+    fn wait_until<T>(
+        &self,
+        cv: &Condvar,
+        g: &mut MutexGuard<'_, T>,
+        deadline: Deadline,
+    ) -> TimedOut {
+        let remaining = self.remaining(deadline);
+        if remaining.is_zero() {
+            return TimedOut(true);
+        }
+        cv.wait_for(g, remaining);
+        TimedOut(deadline.reached(self))
+    }
+    fn wait<T>(&self, cv: &Condvar, g: &mut MutexGuard<'_, T>) {
+        cv.wait(g);
+    }
+    fn sleep_until(&self, deadline: Deadline) {
+        loop {
+            let d = self.remaining(deadline);
+            if d.is_zero() {
+                return;
+            }
+            std::thread::sleep(d);
+        }
+    }
+}
+
+/// Native Rust threads, with no change to the host process's scheduling policy.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct WindowsThreads;
+impl WindowsThreads {
+    /// The process's thread service.
+    pub fn new() -> Self {
+        Self
+    }
+    /// Windows does not install the Linux FIFO scheduling hints.
+    pub fn without_hints() -> Self {
+        Self
+    }
+}
+impl Threads for WindowsThreads {
+    fn spawn(&self, name: &'static str, stack_size: usize, body: Box<dyn FnOnce() + Send>) {
+        if std::thread::Builder::new()
+            .name(name.to_owned())
+            .stack_size(stack_size)
+            .spawn(body)
+            .is_err()
+        {
+            fatal(DeathId::Platform {
+                kind: DeathKind::Abort,
+                call: "CreateThread",
+            });
+        }
+    }
+    fn spawn_worker(&self, label: &'static str, body: Box<dyn FnOnce() + Send>) {
+        self.spawn(label, reims_vgpu_core::rt::queue::WORKER_STACK, body);
+    }
+    fn handle(&self) -> Arc<dyn Threads> {
+        Arc::new(*self)
+    }
+    fn timer_clock(&self) -> Option<Arc<dyn TimerClock>> {
+        Some(Arc::new(WindowsClock::new()))
+    }
+}
