+//! Shared section views implementing the guest's Mach-style memory operations on Windows.
+//!
+//! A section, rather than its first mapping, owns the pages. Every view keeps its section
+//! handle alive. Replacing part of a view preserves the other parts through placeholders.
+
+use std::collections::BTreeMap;
+use std::os::windows::io::{AsRawHandle, FromRawHandle, OwnedHandle};
+use std::sync::{Arc, LazyLock};
+
+use reims_vgpu_core::platform::os::vm::{HostAddr, HostVm, KernReturn, VmProt};
+use reims_vgpu_core::sync::Mutex;
+use windows_sys::Win32::Foundation::{GetLastError, INVALID_HANDLE_VALUE};
+use windows_sys::Win32::System::Memory::*;
+use windows_sys::Win32::System::SystemInformation::{GetSystemInfo, SYSTEM_INFO};
+use windows_sys::Win32::System::SystemServices::MEM_COALESCE_PLACEHOLDERS;
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+const INVALID_ADDRESS: KernReturn = KernReturn(1);
+const INVALID_ARGUMENT: KernReturn = KernReturn(4);
+const FAILURE: KernReturn = KernReturn(5);
+
+/// A section-backed range, including the offset and current access rights of its pages.
+#[derive(Clone, Debug)]
+pub(crate) struct Backing {
+    pub(crate) section: Arc<OwnedHandle>,
+    pub(crate) offset: u64,
+    pub(crate) prot: VmProt,
+}
+
+#[derive(Clone, Debug)]
+struct View {
+    end: u64,
+    backing: Option<Backing>,
+}
+
+#[derive(Default)]
+struct Table {
+    views: BTreeMap<u64, View>,
+    registered: Vec<(u64, u64, Backing, u64)>,
+    next_registration: u64,
+}
+
+static TABLE: LazyLock<Mutex<Table>> = LazyLock::new(|| Mutex::new(Table::default()));
+
+/// One contiguous piece of a range, resolved to its section independently of its source view.
+#[derive(Clone, Debug)]
+pub(crate) struct Piece {
+    pub(crate) at: u64,
+    pub(crate) length: u64,
+    pub(crate) backing: Backing,
+}
+
+fn page_size() -> u64 {
+    let mut info = std::mem::MaybeUninit::<SYSTEM_INFO>::uninit();
+    // SAFETY: a writable SYSTEM_INFO structure.
+    unsafe {
+        GetSystemInfo(info.as_mut_ptr());
+        u64::from(info.assume_init().dwPageSize)
+    }
+}
+
+fn ptr(at: u64) -> *mut std::ffi::c_void {
+    std::ptr::with_exposed_provenance_mut(at as usize)
+}
+
+fn error(call: &str) -> KernReturn {
+    // SAFETY: reads this thread's last error, immediately after the failed call.
+    let code = unsafe { GetLastError() };
+    log::error!(target: "reims_vgpu_vulkan::os", "{call} failed: Win32 error {code}");
+    FAILURE
+}
+
+fn bounds(at: HostAddr, length: u64) -> Result<(u64, u64), KernReturn> {
+    let page = page_size();
+    let first = at.addr() as u64 & !(page - 1);
+    let end = (at.addr() as u64)
+        .checked_add(length)
+        .and_then(|v| v.checked_next_multiple_of(page))
+        .ok_or(INVALID_ARGUMENT)?;
+    Ok((first, end - first))
+}
+
+fn protection(prot: VmProt) -> u32 {
+    match prot.raw() & 3 {
+        0 => PAGE_NOACCESS,
+        1 => PAGE_READONLY,
+        _ => PAGE_READWRITE,
+    }
+}
+
+fn section(length: u64) -> Result<Arc<OwnedHandle>, KernReturn> {
+    // SAFETY: a pagefile-backed section, not a file or another process's handle.
+    let handle = unsafe {
+        CreateFileMappingW(
+            INVALID_HANDLE_VALUE,
+            std::ptr::null(),
+            PAGE_READWRITE,
+            (length >> 32) as u32,
+            length as u32,
+            std::ptr::null(),
+        )
+    };
+    if handle.is_null() {
+        return Err(error("CreateFileMappingW"));
+    }
+    // SAFETY: the new handle has one owner.
+    Ok(Arc::new(unsafe { OwnedHandle::from_raw_handle(handle) }))
+}
+
+fn reserve(length: u64) -> Result<u64, KernReturn> {
+    // SAFETY: reserves unused address space in this process.
+    let at = unsafe {
+        VirtualAlloc2(
+            GetCurrentProcess(),
+            std::ptr::null(),
+            length as usize,
+            MEM_RESERVE | MEM_RESERVE_PLACEHOLDER,
+            PAGE_NOACCESS,
+            std::ptr::null_mut(),
+            0,
+        )
+    };
+    if at.is_null() {
+        Err(error("VirtualAlloc2"))
+    } else {
+        Ok(at as u64)
+    }
+}
+
+fn split(first: u64, length: u64) -> Result<(), KernReturn> {
+    // SAFETY: the caller owns this placeholder; splitting keeps the whole reservation.
+    if unsafe {
+        VirtualFree(
+            ptr(first),
+            length as usize,
+            MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER,
+        )
+    } == 0
+    {
+        Err(error("VirtualFree(split)"))
+    } else {
+        Ok(())
+    }
+}
+
+fn map(first: u64, length: u64, backing: &Backing) -> Result<(), KernReturn> {
+    // SAFETY: the exact owned placeholder is replaced with a shared section view. This flag
+    // permits page-size offsets instead of MapViewOfFile's 64 KiB allocation granularity.
+    let mapped = unsafe {
+        MapViewOfFile3(
+            backing.section.as_raw_handle(),
+            GetCurrentProcess(),
+            ptr(first),
+            backing.offset,
+            length as usize,
+            MEM_REPLACE_PLACEHOLDER,
+            protection(backing.prot),
+            std::ptr::null_mut(),
+            0,
+        )
+    };
+    if mapped.Value.is_null() {
+        Err(error("MapViewOfFile3"))
+    } else {
+        Ok(())
+    }
+}
+
+fn unmap(first: u64) -> Result<(), KernReturn> {
+    // SAFETY: a complete view owned by the table, replaced by an equal placeholder.
+    if unsafe {
+        UnmapViewOfFile2(
+            GetCurrentProcess(),
+            MEMORY_MAPPED_VIEW_ADDRESS { Value: ptr(first) },
+            MEM_PRESERVE_PLACEHOLDER,
+        )
+    } == 0
+    {
+        Err(error("UnmapViewOfFile2"))
+    } else {
+        Ok(())
+    }
+}
+
+impl Table {
+    fn pieces(&self, first: u64, length: u64) -> Option<Vec<Piece>> {
+        let end = first.checked_add(length)?;
+        let mut at = first;
+        let mut result = Vec::new();
+        while at < end {
+            let own = self
+                .views
+                .range(..=at)
+                .next_back()
+                .filter(|(_, v)| v.end > at)
+                .and_then(|(&start, v)| v.backing.as_ref().map(|backing| (start, v.end, backing)));
+            let (start, limit, backing) = own.or_else(|| {
+                self.registered
+                    .iter()
+                    .find(|(a, b, _, _)| *a <= at && at < *b)
+                    .map(|(a, b, s, _)| (*a, *b, s))
+            })?;
+            let next = end.min(limit);
+            let mut backing = backing.clone();
+            backing.offset += at - start;
+            result.push(Piece {
+                at: at - first,
+                length: next - at,
+                backing,
+            });
+            at = next;
+        }
+        Some(result)
+    }
+
+    fn snapshot(&self, first: u64, length: u64) -> Option<Vec<(u64, u64, Option<Backing>)>> {
+        let end = first.checked_add(length)?;
+        let mut at = first;
+        let mut result = Vec::new();
+        while at < end {
+            let (&base, view) = self
+                .views
+                .range(..=at)
+                .next_back()
+                .filter(|(_, v)| at < v.end)?;
+            let to = view.end.min(end);
+            let backing = view.backing.clone().map(|mut b| {
+                b.offset += at - base;
+                b
+            });
+            result.push((at - first, to - at, backing));
+            at = to;
+        }
+        Some(result)
+    }
+
+    /// Splits an owned section view or placeholder without changing its pages.
+    fn cut(&mut self, at: u64) -> Result<(), KernReturn> {
+        let Some((&first, view)) = self
+            .views
+            .range(..at)
+            .next_back()
+            .filter(|(_, v)| at < v.end)
+        else {
+            return Ok(());
+        };
+        let view = view.clone();
+        if view.backing.is_some() {
+            unmap(first)?;
+        }
+        if let Err(why) = split(first, at - first) {
+            if let Some(b) = &view.backing {
+                map(first, view.end - first, b)?;
+            }
+            return Err(why);
+        }
+        let right = view.backing.clone().map(|mut b| {
+            b.offset += at - first;
+            b
+        });
+        if let Some(backing) = &view.backing {
+            if let Err(why) = map(first, at - first, backing) {
+                if unsafe {
+                    VirtualFree(
+                        ptr(first),
+                        (view.end - first) as usize,
+                        MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS,
+                    )
+                } == 0
+                {
+                    std::process::abort();
+                }
+                if map(first, view.end - first, backing).is_err() {
+                    std::process::abort();
+                }
+                return Err(why);
+            }
+            if let Err(why) = map(at, view.end - at, right.as_ref().unwrap()) {
+                if unmap(first).is_err() {
+                    std::process::abort();
+                }
+                if unsafe {
+                    VirtualFree(
+                        ptr(first),
+                        (view.end - first) as usize,
+                        MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS,
+                    )
+                } == 0
+                {
+                    std::process::abort();
+                }
+                if map(first, view.end - first, backing).is_err() {
+                    std::process::abort();
+                }
+                return Err(why);
+            }
+        }
+        self.views.insert(
+            first,
+            View {
+                end: at,
+                backing: view.backing,
+            },
+        );
+        self.views.insert(
+            at,
+            View {
+                end: view.end,
+                backing: right,
+            },
+        );
+        Ok(())
+    }
+
+    fn replace(&mut self, first: u64, length: u64, pieces: &[Piece]) -> Result<(), KernReturn> {
+        let end = first.checked_add(length).ok_or(INVALID_ARGUMENT)?;
+        // Validate ownership before touching any address, including every page of the target.
+        let old = self.snapshot(first, length).ok_or(INVALID_ADDRESS)?;
+        if self
+            .registered
+            .iter()
+            .any(|(a, b, _, _)| *a < end && first < *b)
+        {
+            return Err(INVALID_ARGUMENT);
+        }
+        self.cut(first)?;
+        self.cut(end)?;
+        for p in pieces {
+            self.cut(first + p.at)?;
+            self.cut(first + p.at + p.length)?;
+        }
+        let keys: Vec<u64> = self.views.range(first..end).map(|(&k, _)| k).collect();
+        for key in &keys {
+            if self.views[key].backing.is_some() {
+                unmap(*key)?;
+            }
+            self.views.remove(key);
+        }
+        // The cuts leave exactly the same intervals as the source pieces only where those
+        // boundaries also existed in the old mapping. Coalesce all placeholders first.
+        if unsafe {
+            VirtualFree(
+                ptr(first),
+                length as usize,
+                MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS,
+            )
+        } == 0
+            && keys.len() > 1
+        {
+            return Err(error("VirtualFree(coalesce)"));
+        }
+        let mut done = Vec::new();
+        for (i, p) in pieces.iter().enumerate() {
+            let at = first + p.at;
+            if i + 1 < pieces.len() {
+                split(at, p.length)?;
+            }
+            if let Err(why) = map(at, p.length, &p.backing) {
+                // Preserve the reservation and restore the old pages before returning.
+                for address in &done {
+                    unmap(*address)?;
+                    self.views.remove(address);
+                }
+                if unsafe {
+                    VirtualFree(
+                        ptr(first),
+                        length as usize,
+                        MEM_RELEASE | MEM_COALESCE_PLACEHOLDERS,
+                    )
+                } == 0
+                    && pieces.len() > 1
+                {
+                    return Err(error("VirtualFree(rollback)"));
+                }
+                for (j, (offset, length, backing)) in old.iter().enumerate() {
+                    let at = first + offset;
+                    if j + 1 < old.len() {
+                        split(at, *length)?;
+                    }
+                    if let Some(backing) = backing {
+                        map(at, *length, backing)?;
+                    }
+                    self.views.insert(
+                        at,
+                        View {
+                            end: at + length,
+                            backing: backing.clone(),
+                        },
+                    );
+                }
+                return Err(why);
+            }
+            self.views.insert(
+                at,
+                View {
+                    end: at + p.length,
+                    backing: Some(p.backing.clone()),
+                },
+            );
+            done.push(at);
+        }
+        Ok(())
+    }
+}
+
+/// Resolves a view into independently owned section pieces.
+pub(crate) fn pieces(first: u64, length: u64) -> Option<Vec<Piece>> {
+    TABLE.lock().pieces(first, length)
+}
+
+/// Maps the same section pages writable for a read-only import's protected twin.
+pub(crate) fn writable_alias(target: HostAddr, source: u64, length: u64) -> Result<(), KernReturn> {
+    let mut table = TABLE.lock();
+    let mut pieces = table.pieces(source, length).ok_or(INVALID_ADDRESS)?;
+    for piece in &mut pieces {
+        piece.backing.prot = VmProt::READ | VmProt::WRITE;
+    }
+    table.replace(target.addr() as u64, length, &pieces)
+}
+
+/// The registration lease keeps the host's section open without taking ownership of its view.
+#[derive(Debug)]
+pub struct GuestMemoryLease(Vec<u64>);
+
+impl Drop for GuestMemoryLease {
+    fn drop(&mut self) {
+        let mut t = TABLE.lock();
+        t.registered.retain(|(_, _, _, id)| !self.0.contains(id));
+    }
+}
+
+/// Registers guest ranges until the returned lease is released.
+pub fn register_guest_memory(
+    ranges: impl IntoIterator<Item = (u64, u64, Arc<OwnedHandle>, u64)>,
+) -> GuestMemoryLease {
+    let mut t = TABLE.lock();
+    let mut ids = Vec::new();
+    for (first, length, section, offset) in ranges {
+        let end = first.checked_add(length).expect("validated guest range");
+        t.next_registration += 1;
+        let id = t.next_registration;
+        t.registered.push((
+            first,
+            end,
+            Backing {
+                section,
+                offset,
+                prot: VmProt::READ | VmProt::WRITE,
+            },
+            id,
+        ));
+        ids.push(id);
+    }
+    GuestMemoryLease(ids)
+}
+
+/// Mach-style memory operations backed by shared Win32 sections.
+#[derive(Debug, Default)]
+pub struct WindowsVm;
+
+impl WindowsVm {
+    /// The process's memory service.
+    pub fn new() -> Self {
+        Self
+    }
+    /// Whether every byte is readable, including memory supplied by the host.
+    pub fn readable(&self, at: HostAddr, length: u64) -> bool {
+        let Some(end) = (at.addr() as u64).checked_add(length) else {
+            return false;
+        };
+        let mut next = at.addr() as u64;
+        while next < end {
+            let mut info = std::mem::MaybeUninit::<MEMORY_BASIC_INFORMATION>::uninit();
+            // SAFETY: VirtualQuery inspects mappings without dereferencing the queried address.
+            if unsafe {
+                VirtualQuery(
+                    ptr(next),
+                    info.as_mut_ptr(),
+                    size_of::<MEMORY_BASIC_INFORMATION>(),
+                )
+            } == 0
+            {
+                return false;
+            }
+            let info = unsafe { info.assume_init() };
+            if info.State != MEM_COMMIT || info.Protect & (PAGE_NOACCESS | PAGE_GUARD) != 0 {
+                return false;
+            }
+            next = (info.BaseAddress as u64).saturating_add(info.RegionSize as u64);
+        }
+        true
+    }
+}
+
+impl HostVm for WindowsVm {
+    fn reserve_anywhere(&self, len: u64) -> Result<HostAddr, KernReturn> {
+        let (_, length) = bounds(HostAddr::NULL, len)?;
+        if length == 0 {
+            return Ok(HostAddr::NULL);
+        }
+        let first = reserve(length)?;
+        TABLE.lock().views.insert(
+            first,
+            View {
+                end: first + length,
+                backing: None,
+            },
+        );
+        Ok(HostAddr::from_addr(first as usize))
+    }
+    fn page_size(&self) -> u64 {
+        page_size()
+    }
+    fn page_shift(&self) -> u32 {
+        page_size().trailing_zeros()
+    }
+    fn allocate_anywhere(&self, len: u64) -> Result<HostAddr, KernReturn> {
+        self.allocate_aliasable(len)
+    }
+    fn allocate_aliasable(&self, len: u64) -> Result<HostAddr, KernReturn> {
+        let (_, length) = bounds(HostAddr::NULL, len)?;
+        if length == 0 {
+            return Ok(HostAddr::NULL);
+        }
+        let backing = Backing {
+            section: section(length)?,
+            offset: 0,
+            prot: VmProt::READ | VmProt::WRITE,
+        };
+        let first = reserve(length)?;
+        if let Err(why) = map(first, length, &backing) {
+            unsafe {
+                VirtualFree(ptr(first), 0, MEM_RELEASE);
+            }
+            return Err(why);
+        }
+        TABLE.lock().views.insert(
+            first,
+            View {
+                end: first + length,
+                backing: Some(backing),
+            },
+        );
+        Ok(HostAddr::from_addr(first as usize))
+    }
+    fn allocate_fixed_overwrite(&self, addr: HostAddr, len: u64) -> Result<(), KernReturn> {
+        let (first, length) = bounds(addr, len)?;
+        if length == 0 {
+            return Ok(());
+        }
+        let backing = Backing {
+            section: section(length)?,
+            offset: 0,
+            prot: VmProt::READ | VmProt::WRITE,
+        };
+        TABLE.lock().replace(
+            first,
+            length,
+            &[Piece {
+                at: 0,
+                length,
+                backing,
+            }],
+        )
+    }
+    fn remap_shared_overwrite(
+        &self,
+        dst: HostAddr,
+        src: HostAddr,
+        len: u64,
+    ) -> Result<HostAddr, KernReturn> {
+        let (source, length) = bounds(src, len)?;
+        let (target, _) = bounds(dst, len)?;
+        if length == 0 {
+            return Ok(dst);
+        }
+        let mut t = TABLE.lock();
+        let pieces = t.pieces(source, length).ok_or(INVALID_ADDRESS)?;
+        t.replace(target, length, &pieces)?;
+        Ok(dst)
+    }
+    fn protect_max(&self, addr: HostAddr, len: u64, prot: VmProt) -> Result<(), KernReturn> {
+        let (first, length) = bounds(addr, len)?;
+        if length == 0 {
+            return Ok(());
+        }
+        let mut t = TABLE.lock();
+        let old = t.snapshot(first, length).ok_or(INVALID_ADDRESS)?;
+        if prot != VmProt::NONE && old.iter().any(|(_, _, b)| b.is_none()) {
+            return Err(INVALID_ARGUMENT);
+        }
+        t.cut(first)?;
+        t.cut(first + length)?;
+        for (&at, view) in t.views.range_mut(first..first + length) {
+            if let Some(backing) = &mut view.backing {
+                let allowed = VmProt(backing.prot.raw() & prot.raw());
+                let mut previous = 0;
+                if unsafe {
+                    VirtualProtect(
+                        ptr(at),
+                        (view.end - at) as usize,
+                        protection(allowed),
+                        &mut previous,
+                    )
+                } == 0
+                {
+                    return Err(error("VirtualProtect"));
+                }
+                backing.prot = allowed;
+            }
+        }
+        Ok(())
+    }
+    fn deallocate(&self, addr: HostAddr, len: u64) -> KernReturn {
+        let Ok((first, length)) = bounds(addr, len) else {
+            return INVALID_ARGUMENT;
+        };
+        if length == 0 {
+            return KernReturn::SUCCESS;
+        }
+        let mut t = TABLE.lock();
+        if t.registered
+            .iter()
+            .any(|(a, b, _, _)| *a < first + length && first < *b)
+        {
+            return INVALID_ARGUMENT;
+        }
+        if t.snapshot(first, length).is_none() {
+            return INVALID_ADDRESS;
+        }
+        if let Err(why) = t.cut(first).and_then(|_| t.cut(first + length)) {
+            return why;
+        }
+        let keys: Vec<u64> = t
+            .views
+            .range(first..first + length)
+            .map(|(&k, _)| k)
+            .collect();
+        for key in keys {
+            let released = if t.views[&key].backing.is_some() {
+                unsafe {
+                    UnmapViewOfFile2(
+                        GetCurrentProcess(),
+                        MEMORY_MAPPED_VIEW_ADDRESS { Value: ptr(key) },
+                        0,
+                    )
+                }
+            } else {
+                unsafe { VirtualFree(ptr(key), 0, MEM_RELEASE) }
+            };
+            if released == 0 {
+                return error("deallocate");
+            }
+            t.views.remove(&key);
+        }
+        KernReturn::SUCCESS
+    }
+}
+
+/// Surface-owned shared memory, released after its final GPU keep-alive.
+#[derive(Debug)]
+pub(crate) struct OwnMemory {
+    pub(crate) first: u64,
+    pub(crate) length: u64,
+    registration: Option<GuestMemoryLease>,
+}
+impl OwnMemory {
+    pub(crate) fn new(length: u64) -> Option<Self> {
+        let (_, length) = bounds(HostAddr::NULL, length).ok()?;
+        let at = WindowsVm::new().allocate_aliasable(length).ok()?;
+        let first = at.addr() as u64;
+        let backing = pieces(first, length)?.into_iter().next()?.backing;
+        let registration =
+            register_guest_memory([(first, length, backing.section, backing.offset)]);
+        Some(Self {
+            first,
+            length,
+            registration: Some(registration),
+        })
+    }
+    pub(crate) fn first(&self) -> u64 {
+        self.first
+    }
+}
+impl Drop for OwnMemory {
+    fn drop(&mut self) {
+        drop(self.registration.take());
+        let _ = WindowsVm::new().deallocate(HostAddr::from_addr(self.first as usize), self.length);
+    }
+}
+
+pub(crate) fn allocate_aliasable(length: u64) -> Result<HostAddr, KernReturn> {
+    WindowsVm::new().allocate_aliasable(length)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn surface_owned_pages_are_released_only_by_their_owner() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let owned = OwnMemory::new(p).unwrap();
+        let address = HostAddr::from_addr(owned.first() as usize);
+        assert!(!vm.deallocate(address, p).is_success());
+        assert!(vm.readable(address, p));
+        drop(owned);
+        assert!(!vm.readable(address, p));
+    }
+    #[test]
+    fn a_large_task_reservation_commits_only_the_pages_mapped_into_it() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let length = 1_u64 << 40;
+        let reservation = vm.reserve_anywhere(length).unwrap();
+        vm.protect_max(reservation, length, VmProt::NONE).unwrap();
+        assert!(!vm.readable(reservation, p));
+        let source = vm.allocate_anywhere(p).unwrap();
+        let target = HostAddr::from_addr(reservation.addr() + 3 * p as usize);
+        vm.remap_shared_overwrite(target, source, p).unwrap();
+        unsafe {
+            *(target.addr() as *mut u8) = 87;
+            assert_eq!(*(source.addr() as *const u8), 87);
+        }
+        assert!(!vm.readable(reservation, p));
+        assert!(vm.deallocate(source, p).is_success());
+        assert!(vm.deallocate(reservation, length).is_success());
+    }
+    #[test]
+    fn noncontiguous_aliases_share_pages_and_outlive_the_source() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let source = vm.allocate_anywhere(4 * p).unwrap();
+        let target = vm.allocate_anywhere(2 * p).unwrap();
+        unsafe {
+            *(source.addr() as *mut u8).add(p as usize) = 17;
+            *(source.addr() as *mut u8).add(3 * p as usize) = 51;
+        }
+        vm.remap_shared_overwrite(
+            target,
+            HostAddr::from_addr(source.addr() + 3 * p as usize),
+            p,
+        )
+        .unwrap();
+        vm.remap_shared_overwrite(
+            HostAddr::from_addr(target.addr() + p as usize),
+            HostAddr::from_addr(source.addr() + p as usize),
+            p,
+        )
+        .unwrap();
+        unsafe {
+            assert_eq!(*(target.addr() as *const u8), 51);
+            *(target.addr() as *mut u8) = 73;
+            assert_eq!(*(source.addr() as *const u8).add(3 * p as usize), 73);
+        }
+        assert!(vm.deallocate(source, 4 * p).is_success());
+        unsafe {
+            assert_eq!(*(target.addr() as *const u8), 73);
+            assert_eq!(*(target.addr() as *const u8).add(p as usize), 17);
+        }
+        assert!(vm.deallocate(target, 2 * p).is_success());
+    }
+    #[test]
+    fn fixed_zero_overwrite_preserves_neighbouring_pages() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let source = vm.allocate_anywhere(3 * p).unwrap();
+        unsafe {
+            std::ptr::write_bytes(source.addr() as *mut u8, 43, (3 * p) as usize);
+        }
+        vm.allocate_fixed_overwrite(HostAddr::from_addr(source.addr() + p as usize), p)
+            .unwrap();
+        unsafe {
+            assert_eq!(*(source.addr() as *const u8), 43);
+            assert_eq!(*(source.addr() as *const u8).add(p as usize), 0);
+            assert_eq!(*(source.addr() as *const u8).add(2 * p as usize), 43);
+        }
+        assert!(vm.deallocate(source, 3 * p).is_success());
+    }
+    #[test]
+    fn unknown_source_is_refused_without_changing_the_target() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let target = vm.allocate_anywhere(p).unwrap();
+        unsafe {
+            *(target.addr() as *mut u8) = 71;
+        }
+        assert!(
+            vm.remap_shared_overwrite(target, HostAddr::NULL, p)
+                .is_err()
+        );
+        unsafe {
+            assert_eq!(*(target.addr() as *const u8), 71);
+        }
+        assert!(vm.deallocate(target, p).is_success());
+    }
+    #[test]
+    fn a_kernel_refused_section_view_restores_the_target() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let target = vm.allocate_anywhere(3 * p).unwrap();
+        unsafe {
+            std::ptr::write_bytes(target.addr() as *mut u8, 29, (3 * p) as usize);
+        }
+        let source = 0x10000;
+        let lease = register_guest_memory([(source, p, section(p).unwrap(), 2 * p)]);
+        assert!(
+            vm.remap_shared_overwrite(
+                HostAddr::from_addr(target.addr() + p as usize),
+                HostAddr::from_addr(source as usize),
+                p
+            )
+            .is_err()
+        );
+        let bytes =
+            unsafe { std::slice::from_raw_parts(target.addr() as *const u8, (3 * p) as usize) };
+        assert!(bytes.iter().all(|&b| b == 29));
+        drop(lease);
+        assert!(vm.deallocate(target, 3 * p).is_success());
+    }
+    #[test]
+    fn maximum_read_protection_is_preserved_by_later_aliases() {
+        let vm = WindowsVm::new();
+        let p = vm.page_size();
+        let source = vm.allocate_anywhere(p).unwrap();
+        let target = vm.allocate_anywhere(p).unwrap();
+        vm.protect_max(source, p, VmProt::READ).unwrap();
+        vm.remap_shared_overwrite(target, source, p).unwrap();
+        assert_eq!(
+            pieces(target.addr() as u64, p).unwrap()[0].backing.prot,
+            VmProt::READ
+        );
+        assert!(vm.deallocate(source, p).is_success());
+        assert!(vm.deallocate(target, p).is_success());
+    }
+}
