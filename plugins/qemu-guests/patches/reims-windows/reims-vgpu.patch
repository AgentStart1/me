index 0000000..73240ba
--- /dev/null
+++ b/crates/reims-vgpu-c/src/device/sections.rs
@@ -0,0 +1,98 @@
+//! Validate and duplicate native section handles at the Windows host boundary.
+use super::*;
+use std::os::windows::io::{FromRawHandle, OwnedHandle};
+use windows_sys::Win32::Foundation::{DUPLICATE_SAME_ACCESS, DuplicateHandle};
+use windows_sys::Win32::System::Memory::{FILE_MAP_READ, MapViewOfFile, UnmapViewOfFile};
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+
+/// The host guarantees all counted structures and mapped ranges remain valid for this call.
+pub(super) unsafe fn memory_map(
+    map: *const RvgMemoryMap,
+    files: *const RvgMemoryRangeFile,
+    sections: *const RvgMemoryRangeSection,
+) -> Result<Option<MemoryMap>, RvgStatus> {
+    if !files.is_null() {
+        return Err(RVG_ERR_INVALID_ARGUMENT);
+    }
+    let Some(map) = (unsafe { map.as_ref() }) else {
+        return if sections.is_null() {
+            Ok(None)
+        } else {
+            Err(RVG_ERR_INVALID_ARGUMENT)
+        };
+    };
+    if map.range_count > 0 && map.ranges.is_null() {
+        return Err(RVG_ERR_INVALID_ARGUMENT);
+    }
+    let ranges = if map.range_count == 0 {
+        &[]
+    } else {
+        unsafe { std::slice::from_raw_parts(map.ranges, map.range_count) }
+    };
+    let mut result = MemoryMap::new();
+    for (i, range) in ranges.iter().enumerate() {
+        let section = if sections.is_null() {
+            None
+        } else {
+            let entry = unsafe { &*sections.add(i) };
+            if entry.handle == 0 {
+                None
+            } else {
+                let mut info = std::mem::MaybeUninit::uninit();
+                unsafe {
+                    windows_sys::Win32::System::SystemInformation::GetSystemInfo(info.as_mut_ptr());
+                }
+                let page = u64::from(unsafe { info.assume_init() }.dwPageSize);
+                if entry.offset % page != 0 {
+                    return Err(RVG_ERR_INVALID_ARGUMENT);
+                }
+                let size = entry
+                    .offset
+                    .checked_add(range.physical_length)
+                    .and_then(|v| usize::try_from(v).ok())
+                    .filter(|&v| v > 0)
+                    .ok_or(RVG_ERR_INVALID_ARGUMENT)?;
+                let mut duplicate = std::ptr::null_mut();
+                // SAFETY: DuplicateHandle validates the borrowed native handle and gives this
+                // process an independent, non-inheritable reference with the same rights.
+                if unsafe {
+                    DuplicateHandle(
+                        GetCurrentProcess(),
+                        entry.handle as *mut c_void,
+                        GetCurrentProcess(),
+                        &mut duplicate,
+                        0,
+                        0,
+                        DUPLICATE_SAME_ACCESS,
+                    )
+                } == 0
+                {
+                    return Err(RVG_ERR_INVALID_ARGUMENT);
+                }
+                let owned = unsafe { OwnedHandle::from_raw_handle(duplicate) };
+                // The temporary view checks both object type and section bounds. No bytes are
+                // read, and it is gone before a device or GPU import is created.
+                let checked = unsafe { MapViewOfFile(duplicate, FILE_MAP_READ, 0, 0, size) };
+                if checked.Value.is_null() {
+                    return Err(RVG_ERR_INVALID_ARGUMENT);
+                }
+                if unsafe { UnmapViewOfFile(checked) } == 0 {
+                    return Err(RVG_ERR_INVALID_ARGUMENT);
+                }
+                Some(MemoryFile {
+                    section: Arc::new(owned),
+                    offset: entry.offset,
+                })
+            }
+        };
+        unsafe {
+            result.push_with_file(
+                range.physical_address,
+                range.physical_length,
+                range.host_address.cast(),
+                section,
+            );
+        }
+    }
+    Ok(Some(result))
+}
