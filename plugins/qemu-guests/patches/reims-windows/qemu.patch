diff --git a/target/i386/whpx/whpx-cpuid.h b/target/i386/whpx/whpx-cpuid.h
new file mode 100644
index 0000000..1e29e15
--- /dev/null
+++ b/target/i386/whpx/whpx-cpuid.h
@@ -0,0 +1,23 @@
+/*
+ * WHPX CPUID capability intersection.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef WHPX_CPUID_H
+#define WHPX_CPUID_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Preserve unrelated bits; CET requires both guest and WHPX support, plus
+ * the guest XSAVE/XSAVES path used to preserve per-thread CET state.
+ */
+static inline uint32_t whpx_filter_cet_cpuid(uint32_t model, uint32_t host,
+                                           uint32_t cet_mask,
+                                           bool xsave, bool xsaves)
+{
+    uint32_t cet = xsave && xsaves ? model & host & cet_mask : 0;
+
+    return (model & ~cet_mask) | cet;
+}
+
+#endif /* WHPX_CPUID_H */
diff --git a/util/oslib-win32.c b/util/oslib-win32.c
index 5f3e8f4..40043ca 100644
