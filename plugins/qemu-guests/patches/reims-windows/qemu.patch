+++ b/util/oslib-win32.c
@@ -36,6 +36,35 @@
 #include "qemu/error-report.h"
 #include <malloc.h>
 
+typedef struct Win32RamSection {
+    void *base;
+    size_t size;
+    HANDLE section;
+    struct Win32RamSection *next;
+} Win32RamSection;
+
+static SRWLOCK ram_sections_lock = SRWLOCK_INIT;
+static Win32RamSection *ram_sections;
+
+uintptr_t qemu_win32_ram_section(void *address, uint64_t *offset)
+{
+    Win32RamSection *entry;
+    uintptr_t result = 0;
+    uintptr_t at = (uintptr_t)address;
+
+    AcquireSRWLockShared(&ram_sections_lock);
+    for (entry = ram_sections; entry; entry = entry->next) {
+        uintptr_t base = (uintptr_t)entry->base;
+        if (at >= base && at - base < entry->size) {
+            *offset = at - base;
+            result = (uintptr_t)entry->section;
+            break;
+        }
+    }
+    ReleaseSRWLockShared(&ram_sections_lock);
+    return result;
+}
