+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef QEMU_GL_SNAPSHOT_H
+#define QEMU_GL_SNAPSHOT_H
+
+#include <epoxy/gl.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+
+/* Current-context only. The caller owns the bounded output buffer. */
+static bool qemu_gl_snapshot_read(GLuint framebuffer, int backing_height,
+                                 int x, int y,
+                                 int width, int height, int stride,
+                                 uint8_t *data, bool backing_y0_top,
+                                 const char **reason)
+{
+    GLint old_read_fb, old_read_buffer, old_pack_buffer;
+    GLint old_alignment, old_row_length, old_skip_rows, old_skip_pixels;
+    uint8_t *row = NULL;
+    bool success = false;
+
+    if (width <= 0 || height <= 0 || width > INT_MAX / 4 ||
+        stride < width * 4 || stride % 4 || !data || x < 0 || y < 0 ||
+        backing_height < height || y > backing_height - height) {
+        *reason = "invalid snapshot dimensions";
+        return false;
+    }
+    if (glGetError() != GL_NO_ERROR) {
+        *reason = "pre-existing OpenGL error";
+        return false;
+    }
+    if (backing_y0_top) {
+        row = malloc(width * 4);
+        if (!row) {
+            *reason = "snapshot row allocation failed";
+            return false;
+        }
+    }
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read_fb);
+    glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &old_pack_buffer);
+    glGetIntegerv(GL_PACK_ALIGNMENT, &old_alignment);
+    glGetIntegerv(GL_PACK_ROW_LENGTH, &old_row_length);
+    glGetIntegerv(GL_PACK_SKIP_ROWS, &old_skip_rows);
+    glGetIntegerv(GL_PACK_SKIP_PIXELS, &old_skip_pixels);
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, framebuffer);
+    glGetIntegerv(GL_READ_BUFFER, &old_read_buffer);
+    if (glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        *reason = "incomplete scanout framebuffer";
+        goto restore;
+    }
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glPixelStorei(GL_PACK_ROW_LENGTH, stride / 4);
+    glPixelStorei(GL_PACK_SKIP_ROWS, 0);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    /* Match SDL's scanout blit, then convert its lower-left GL origin to PNG rows. */
+    glReadPixels(x, backing_y0_top ? backing_height - y - height : y,
+                 width, height, GL_RGBA, GL_UNSIGNED_BYTE, data);
+    if (glGetError() != GL_NO_ERROR) {
+        *reason = "OpenGL scanout readback failed";
+        goto restore;
+    }
+    if (backing_y0_top) {
+        for (int top = 0; top < height / 2; top++) {
+            uint8_t *a = data + (size_t)top * stride;
+            uint8_t *b = data + (size_t)(height - top - 1) * stride;
+            memcpy(row, a, width * 4);
+            memcpy(a, b, width * 4);
+            memcpy(b, row, width * 4);
+        }
+    }
+    success = true;
+restore:
+    glReadBuffer(old_read_buffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read_fb);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, old_pack_buffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, old_alignment);
+    glPixelStorei(GL_PACK_ROW_LENGTH, old_row_length);
+    glPixelStorei(GL_PACK_SKIP_ROWS, old_skip_rows);
+    glPixelStorei(GL_PACK_SKIP_PIXELS, old_skip_pixels);
+    free(row);
+    return success;
+}
+
+#endif
