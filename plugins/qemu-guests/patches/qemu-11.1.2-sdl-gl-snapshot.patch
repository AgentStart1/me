+pixman_image_t *sdl2_gl_snapshot(DisplayChangeListener *dcl, Error **errp)
+{
+    struct sdl2_console *scon = container_of(dcl, struct sdl2_console, dcl);
+    SDL_Window *previous_window = SDL_GL_GetCurrentWindow();
+    SDL_GLContext previous_context = SDL_GL_GetCurrentContext();
+    pixman_image_t *image = NULL;
+    const char *reason = NULL;
+
+    if (!scon->scanout_mode || !scon->real_window ||
+        !scon->guest_fb.framebuffer || scon->x < 0 || scon->y < 0 ||
+        scon->w <= 0 || scon->h <= 0 ||
+        scon->x > scon->guest_fb.width || scon->y > scon->guest_fb.height ||
+        scon->w > scon->guest_fb.width - scon->x ||
+        scon->h > scon->guest_fb.height - scon->y) {
+        error_setg(errp, "SDL GL scanout is unavailable or out of bounds");
+        return NULL;
+    }
+    if (SDL_GL_MakeCurrent(scon->real_window, scon->winctx)) {
+        error_setg(errp, "Cannot select SDL snapshot context: %s", SDL_GetError());
+        return NULL;
+    }
+    /* Separate storage survives QMP encoder yields and concurrent guest updates. */
+    image = pixman_image_create_bits(PIXMAN_x8b8g8r8, scon->w, scon->h, NULL, 0);
+    if (!image) {
+        reason = "snapshot image allocation failed";
+        goto restore;
+    }
+    if (!qemu_gl_snapshot_read(scon->guest_fb.framebuffer,
+                              scon->guest_fb.height, scon->x, scon->y,
+                              scon->w, scon->h, pixman_image_get_stride(image),
+                              (uint8_t *)pixman_image_get_data(image),
+                              scon->y0_top, &reason)) {
+        pixman_image_unref(image);
+        image = NULL;
+    }
+restore:
+    if (SDL_GL_MakeCurrent(previous_window, previous_context)) {
+        if (image) {
+            pixman_image_unref(image);
+            image = NULL;
+        }
+        reason = "cannot restore SDL context after snapshot";
+    }
+    if (!image) {
+        error_setg(errp, "SDL GL snapshot failed: %s", reason);
+    }
+    return image;
+}
