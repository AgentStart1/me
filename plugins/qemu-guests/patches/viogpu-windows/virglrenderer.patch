+/* Gallium Z24S8 stores depth in bits 0..23; GL_UNSIGNED_INT_24_8
+ * stores it in bits 8..31. Convert only tightly packed temporary transfers,
+ * never the guest iovec in place. Native S8Z24 resources need no conversion. */
+static void vrend_repack_z24s8(void *data, uint64_t size, bool to_gl)
+{
+   uint32_t *words = data;
+   for (uint64_t i = 0; i < size / sizeof(*words); i++) {
+      uint32_t value = words[i];
+      words[i] = to_gl ? (value << 8) | (value >> 24)
+                       : (value >> 8) | (value << 24);
+   }
+}
