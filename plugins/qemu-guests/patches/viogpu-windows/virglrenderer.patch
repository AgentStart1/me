+/* Gallium keeps Z24 in the low 24 bits. GL_UNSIGNED_INT normalizes all
+ * 32 bits: replicate the high eight bits on upload, discard them on readback.
+ * Call only on owned, tightly packed staging memory. */
+static void vrend_repack_z24x8(void *data, uint64_t size, bool to_gl)
+{
+   uint32_t *words = data;
+   for (uint64_t i = 0; i < size / sizeof(*words); i++) {
+      uint32_t value = words[i];
+      words[i] = to_gl ? (value << 8) | ((value & 0xffffff) >> 16)
+                       : value >> 8;
+   }
+}
