Subject: [LOCAL QEMU 11.1.2] Reset WHPX partition during machine reset

Adapted from Mohamed Mediouni's upstream proposal:
https://patchew.org/QEMU/20260421205749.55060-1-mohamed@unpredictable.fr/

Apply only to QEMU v11.1.2. Adds bounded reset success/failure diagnostics.
This local adaptation is not an upstream release or a Windows 10 fix.
QEMU source and this adaptation are GPL-2.0-or-later.

--- a/accel/accel-system.c
+++ b/accel/accel-system.c
@@ -76,6 +76,16 @@
     }
 }
 
+void accel_reset(MachineState *ms)
+{
+    AccelState *accel = ms->accelerator;
+    AccelClass *acc = ACCEL_GET_CLASS(accel);
+
+    if (acc->reset_vm) {
+        acc->reset_vm(accel);
+    }
+}
+
 /* initialize the arch-independent accel operation interfaces */
 void accel_init_ops_interfaces(AccelClass *ac)
 {
--- a/accel/whpx/whpx-common.c
+++ b/accel/whpx/whpx-common.c
@@ -231,6 +231,22 @@
     run_on_cpu(cpu, do_whpx_cpu_synchronize_pre_loadvm, RUN_ON_CPU_NULL);
 }
 
+static void whpx_partition_reset(AccelState *as)
+{
+    HRESULT hr;
+
+    if (!whp_dispatch.WHvResetPartition) {
+        warn_report("WHPX: partition reset API unavailable");
+        return;
+    }
+    hr = whp_dispatch.WHvResetPartition(whpx_global.partition);
+    if (FAILED(hr)) {
+        error_report("WHPX: partition reset failed, hr=%08lx", hr);
+    } else {
+        info_report("WHPX: partition reset completed");
+    }
+}
+
 static void whpx_pre_resume_vm(AccelState *as, bool step_pending)
 {
     whpx_global.step_pending = step_pending;
@@ -526,6 +542,7 @@
     ac->name = "WHPX";
     ac->init_machine = whpx_accel_init;
     ac->pre_resume_vm = whpx_pre_resume_vm;
+    ac->reset_vm = whpx_partition_reset;
     ac->allowed = &whpx_allowed;
 
     object_class_property_add(oc, "kernel-irqchip", "on|off|split",
