@@ -0,0 +1,23 @@
+/*
+ * WHPX CPUID capability intersection.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef WHPX_CPUID_H
+#define WHPX_CPUID_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* Preserve unrelated bits; CET requires both guest and WHPX support, plus
+ * the guest XSAVE/XSAVES path used to preserve per-thread CET state.
+ */
+static inline uint32_t whpx_filter_cet_cpuid(uint32_t model, uint32_t host,
+                                           uint32_t cet_mask,
+                                           bool xsave, bool xsaves)
+{
+    uint32_t cet = xsave && xsaves ? model & host & cet_mask : 0;
+
+    return (model & ~cet_mask) | cet;
+}
+
+#endif /* WHPX_CPUID_H */
