{
  "name": "macos-kvm-work",
  "os": "macos",
  "state_dir": "~/.qemu-guests/macos-kvm-work",
  "qemu_runtime": "system",
  "media_sha256": "REPLACE_WITH_VERIFIED_SHA256",
  "disk_size": "64G",
  "memory": 4096,
  "cpus": 4,
  "ssh_port": 2232,
  "ssh_user": "developer",
  "access_key": "~/.ssh/qemu-work",
  "qemu_args": [
    "-accel",
    "kvm",
    "-cpu",
    "Haswell-noTSX,stepping=3,kvm=on,vendor=GenuineIntel,+invtsc,vmware-cpuid-freq=on,-vmx,-svm,-pcid"
  ],
  "timeout": 3600,
  "installer_iso": "/private/macos-installer.iso",
  "graphical": true,
  "qmp_port": 2242,
  "hardware_args": [
    "-machine",
    "q35",
    "-device",
    "qemu-xhci,id=xhci",
    "-device",
    "usb-kbd,bus=xhci.0",
    "-device",
    "usb-tablet,bus=xhci.0",
    "-device",
    "isa-applesmc,osk=REPLACE_WITH_OPERATOR_SUPPLIED_OSK",
    "-drive",
    "if=pflash,format=raw,readonly=on,file=/private/OVMF_CODE.fd",
    "-drive",
    "if=pflash,format=raw,file={state}/vars.fd",
    "-smbios",
    "type=2",
    "-device",
    "ich9-ahci,id=sata",
    "-drive",
    "id=opencore,if=none,format=raw,file=/private/opencore.raw,snapshot=on",
    "-device",
    "ide-hd,bus=sata.2,drive=opencore",
    "-drive",
    "id=workdisk,file={disk},format=qcow2,if=none",
    "-device",
    "ide-hd,bus=sata.4,drive=workdisk,serial=work-target",
    "-netdev",
    "user,id=worknet,hostfwd=tcp:127.0.0.1:{ssh_port}-:22",
    "-device",
    "vmxnet3,netdev=worknet,romfile=",
    "-vga",
    "none",
    "-device",
    "vmware-svga"
  ],
  "macos": {
    "installer_app": "/Volumes/Image Volume/Install macOS Sonoma.app",
    "target_disk": "serial:work-target",
    "bootstrap_package": "/private/bootstrap.pkg",
    "tesseract": "tesseract"
  },
  "appium": {
    "host_port": 4732,
    "runtime_archive": "/private/appium-macos.zip",
    "sha256": "REPLACE_WITH_RUNTIME_SHA256"
  }
}
