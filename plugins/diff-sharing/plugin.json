{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "diff-sharing",
  "version": "0.2.9-20261111062540",
  "description": "生成 Git 或 Difftastic 代码差异站点，用于本地预览或 ngrok 分享。",
  "author": {
    "name": "Diff Sharing"
  },
  "license": "MIT",
  "keywords": [
    "diff",
    "difftastic",
    "git",
    "ngrok",
    "code-review"
  ],
  "extensions": {
    "com.openai.codex": {
      "skills": "./skills/",
      "interface": {
        "displayName": "代码差异分享",
        "shortDescription": "本地预览代码差异报告，或分享公开 URL。",
        "longDescription": "生成优先使用 Difftastic 的可浏览结构化差异站点，提供 Git 回退及行内、并排布局。除非要求公开分享，否则 skill 使用本地预览。",
        "developerName": "Diff Sharing",
        "category": "Developer Tools",
        "capabilities": [
          "Difftastic Diff Generation",
          "Git Diff Fallback",
          "Ngrok Tunnel"
        ],
        "defaultPrompt": [
          "将此分支变更生成为本地差异报告预览。",
          "生成代码差异报告并分享公开 URL。"
        ],
        "brandColor": "#2563EB"
      }
    },
    "com.anthropic.claude": {
      "skills": [
        "./skills/"
      ],
      "skillFrontmatter": {
        "diff-sharing": {
          "context": "fork",
          "agent": "diff-sharing-operator"
        }
      }
    }
  }
}
