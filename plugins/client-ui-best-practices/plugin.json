{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "client-ui-best-practices",
  "version": "0.3.5-20261107120055",
  "description": "通过跨平台 Host 架构管理客户端 UI 状态、副作用、生命周期和线程约束。",
  "author": {
    "name": "Local developer"
  },
  "license": "MIT",
  "keywords": [
    "android",
    "async",
    "client",
    "main-thread",
    "sharedflow",
    "stateflow",
    "ui"
  ],
  "extensions": {
    "com.openai.codex": {
      "skills": "./skills/",
      "interface": {
        "displayName": "客户端 UI 最佳实践",
        "shortDescription": "保持界面响应流畅，以状态驱动渲染。",
        "longDescription": "指导客户端开发，让 UI 线程聚焦视图更新和渲染，业务逻辑与 I/O 异步执行，通过可观察 UI 状态和一次性副作用更新页面。",
        "developerName": "Local developer",
        "category": "Developer Tools",
        "capabilities": [
          "Code Review",
          "Code Generation",
          "Debugging"
        ],
        "defaultPrompt": [
          "检查此客户端页面是否违反主线程约束。",
          "将此 UI 流程重构为 StateFlow 驱动的渲染。",
          "安全地将业务工作移出 UI 线程。"
        ],
        "brandColor": "#0F766E"
      }
    },
    "com.anthropic.claude": {
      "skillFrontmatter": {
        "client-ui-best-practices": {
          "context": "fork",
          "agent": "client-ui-architecture-reviewer"
        }
      }
    }
  }
}
