{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "recyclerview-best-practice",
  "version": "0.3.5-20261107120055",
  "description": "Android RecyclerView 的 adapter、差异计算、分页、状态、前插锚点和性能指引。",
  "author": {
    "name": "Local Android Practices"
  },
  "license": "MIT",
  "keywords": [
    "android",
    "recyclerview",
    "diffutil",
    "paging",
    "listadapter",
    "kotlin"
  ],
  "extensions": {
    "com.openai.codex": {
      "skills": "./skills/",
      "interface": {
        "displayName": "RecyclerView 最佳实践",
        "shortDescription": "审查和实现稳健的 Android RecyclerView 代码。",
        "longDescription": "指导 Codex 编辑 Android RecyclerView 代码时，优先采用支持差异计算的 adapter、正确的生命周期收集、稳定绑定模式、条目状态分离及聚焦测试。",
        "developerName": "Local Android Practices",
        "category": "Developer Tools",
        "capabilities": [
          "Code Review",
          "Code Generation",
          "Android"
        ],
        "defaultPrompt": [
          "审查此 RecyclerView 实现。",
          "将此 adapter 重构为差异计算更新。",
          "为此列表添加 Paging 3 支持。"
        ],
        "brandColor": "#2E7D32"
      }
    },
    "com.anthropic.claude": {}
  }
}
