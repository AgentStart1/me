{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "test-report-sharing",
  "version": "0.4.8-20261111062540",
  "description": "将测试报告收集为静态站点，用于本地预览或 ngrok 分享。",
  "author": {
    "name": "Test Report Sharing"
  },
  "license": "MIT",
  "keywords": [
    "test-results",
    "ngrok",
    "report-sharing"
  ],
  "extensions": {
    "com.openai.codex": {
      "skills": "./skills/",
      "interface": {
        "displayName": "测试报告分享",
        "shortDescription": "本地预览已有测试报告，或分享公开 URL。",
        "longDescription": "将已有测试报告收集为可浏览静态站点。除非要求公开分享，否则 skill 使用本地预览；收集报告不会重新运行测试。",
        "developerName": "Test Report Sharing",
        "category": "Developer Tools",
        "capabilities": [
          "Test Reporting",
          "Ngrok Tunnel"
        ],
        "defaultPrompt": [
          "收集已有测试报告并显示本地预览。",
          "通过公开 URL 分享已有测试报告。"
        ],
        "brandColor": "#2563EB"
      }
    },
    "com.anthropic.claude": {
      "skills": [
        "./skills/"
      ],
      "skillFrontmatter": {
        "test-report-sharing": {
          "context": "fork",
          "agent": "test-report-operator"
        }
      }
    }
  }
}
